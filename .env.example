# Copy to .env and adjust. Never commit the real .env file.
# Only variables that the code actually reads are listed here.

# --- Django ---------------------------------------------------------------
# Settings used by manage.py / runserver on your machine.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Settings used inside docker compose (web, worker, beat, migrate).
DJANGO_SETTINGS_MODULE_DOCKER=config.settings.prod
# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed in production when the site is served over HTTPS behind a proxy
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
LOG_LEVEL=INFO

# --- CORS -----------------------------------------------------------------
# dev.py allows every origin by default; prod.py always uses the explicit list.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=True

# --- Database (PostgreSQL) ---------------------------------------------------
# `docker compose up -d db` starts PostgreSQL with these same credentials.
# Tests use them too (Django creates a separate test_<DB_NAME> database).
DB_NAME=shopdb
DB_USER=shopuser
DB_PASSWORD=change-me
# 127.0.0.1 rather than localhost: on Windows "localhost" tries IPv6 first and
# every refused ::1 connection costs about 2 seconds.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
# Set to django.db.backends.sqlite3 to try the project without PostgreSQL.
DB_ENGINE=django.db.backends.postgresql

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Optional, default to REDIS_URL
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Optional, cache backend used by prod.py (defaults to REDIS_URL)
CACHE_URL=
# Set to True to run tasks inline without a worker (handy for local debugging)
CELERY_TASK_ALWAYS_EAGER=False

# --- Auth / OTP / throttling ---------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
THROTTLE_RATE_REGISTER=5/hour
THROTTLE_RATE_LOGIN=10/min
THROTTLE_RATE_OTP_REQUEST=5/min
THROTTLE_RATE_OTP_VERIFY=10/min

# --- SMS (Kavenegar) for phone OTPs; empty key = SMS disabled ------------------
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# --- Email ----------------------------------------------------------------
# dev.py prints emails to the console unless EMAIL_BACKEND is set.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10

# --- Zarinpal -------------------------------------------------------------
ZARINPAL_MERCHANT_ID=
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
ZARINPAL_CALLBACK_URL=http://127.0.0.1:8000/api/payments/verify/
ZARINPAL_TIMEOUT=15
# Unit of prices stored in the DB: TOMAN or RIAL (Zarinpal is always paid in Rial)
PRICE_UNIT=TOMAN

# --- Media ----------------------------------------------------------------
# Serve uploaded files from Django when DEBUG=False (docker-compose sets True)
SERVE_MEDIA=False
GUNICORN_WORKERS=3

# --- Inventory ------------------------------------------------------------
INVENTORY_LOW_STOCK_THRESHOLD=3

# --- Production only (config.settings.prod) --------------------------------
# docker compose ignores SECURE_SSL_REDIRECT and uses DOCKER_SECURE_SSL_REDIRECT
# (default False) so the local stack works over plain http.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# --- Admin (Jazzmin) branding, optional ------------------------------------
ADMIN_SITE_TITLE=
ADMIN_SITE_HEADER=
ADMIN_SITE_BRAND=
ADMIN_WELCOME_SIGN=
ADMIN_LOGO=icons/desktop-logo.svg
ADMIN_LOGIN_LOGO=icons/desktop-logo.svg
ADMIN_FAVICON=icons/desktop-logo.svg
ADMIN_THEME=flatly
ADMIN_DARK_THEME=darkly
